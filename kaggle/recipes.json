      "submission": {"name": "flow-v1284", "ref": 56564308}
    },
    "flow-ownhead": {
      "extends": "flow-v1284",
      "slug": "ctg-lane-r-flow-ownhead",
      "description": "Our own coordinate head instead of the public one (best private family; not selected).",
      "env": {"V1284_HEAD_DATASET": "impala9397/ctg-coordhead-own32-r4s0",
              "V1284_HEAD_SHA256": "649645d68ea9bc5f9e85388a2ac7dbca94fb52232ef129d7208824a99b7e0dad"},
      "submission": {"name": "flow-ownhead", "ref": 56592384}
    },
    "flow-v1284-headavg": {
      "extends": "flow-v1284",
      "slug": "ctg-lane-r-flow-v1284-headavg",
      "description": "Displacement = mean of the public head and our own head (bounded displacements, µm).",
      "env": {"V1284_HEAD2_DATASET": "impala9397/ctg-coordhead-own32-r4s0",
              "V1284_HEAD2_SHA256": "649645d68ea9bc5f9e85388a2ac7dbca94fb52232ef129d7208824a99b7e0dad"},
      "submission": {"name": "flow-v1284-headavg", "ref": 56622872}
    },
    "flow-v1284-pmax8": {
      "extends": "flow-v1284",
      "slug": "ctg-lane-r-flow-v1284-pmax8",
      "description": "Safe-division parent-to-daughter gate 9 -> 8 µm.",
      "overrides": [{"BIOHUB_SAFE_DIV_MAX_UM": "8.0"}],
      "submission": {"name": "flow-v1284-pmax8", "ref": 56622718}
    },
    "final-headavg-pmax8": {
      "extends": "flow-v1284-headavg",
      "slug": "ctg-lane-r-headavg-pmax8",
