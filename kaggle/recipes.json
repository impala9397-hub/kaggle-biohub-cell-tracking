              "V1284_HEAD2_SHA256S": "649645d68ea9bc5f9e85388a2ac7dbca94fb52232ef129d7208824a99b7e0dad,de98f1fc6c5234d163a735f37d897a0994407ab2a9a9603160e825896f7cd8cb,8bc3e3dfcb2ef06837eb024688db3d7ddf56cc9594d2f5c915cd36404c786840,b1980ddf15c1b7a248a12e38b05fe609a46dd4e6fbf7682595154819e73a46f4,4056df8897b541a2079a1117fb7aac142e391c6cf6f885ededd2ad5f30eb33b8"},
      "overrides": [{"BIOHUB_SAFE_DIV_MAX_UM": "8.0"}],
